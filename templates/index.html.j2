<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="htmx-config" content='{"morphIgnore":["data-htmx-powered","data-grabbing","data-pending-delete","data-pred-x","data-pred-y","data-pred-sx","data-pred-sy"]}'>
  <title>Hyperspace</title>

  <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
  <link href="/static/css/output.css?v=mobile4" rel="stylesheet">

  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

  <script src="/static/js/vendor/htmx.min.js"></script>
  <script src="/static/js/vendor/hx-live.min.js"></script>
  <script src="/static/js/vendor/hx-optimistic.min.js"></script>
  <script src="/static/js/vendor/idiomorph.min.js"></script>
  <script src="/static/js/vendor/fzstd.min.js"></script>
  <script src="/static/js/hyperspace.js"></script>
</head>

<body class="group/body bg-background text-foreground font-mono h-screen overflow-hidden touch-none"
      data-session="{{ current_session_id }}"
      hx-on="
        keydown[event.key=='Shift'] -> data.deleteMode = true;
        keyup[event.key=='Shift']   -> data.deleteMode = false;
        pointermove -> {
          if (!data.dragBrick) return;
          var dx = event.clientX - parseInt(data.dragStartX);
          var dy = event.clientY - parseInt(data.dragStartY);
          if (data.dragMoved !== '1' && Math.abs(dx) + Math.abs(dy) > 8) {
            data.dragMoved = '1';
            hyperspace.call('start_drag', [parseInt(data.dragBrick)]);
          }
          if (data.dragMoved !== '1') return;
          var el = document.getElementById('block-' + data.dragBrick);
          if (el) el.style.pointerEvents = 'none';
          var under = document.elementFromPoint(event.clientX, event.clientY);
          if (el) el.style.pointerEvents = '';
          if (!under) return;
          var target = under.closest('[data-brick-id]') || under.closest('button[data-cell-x]');
          if (!target) return;
          var cx = target.dataset.x ?? target.dataset.cellX;
          var cy = target.dataset.y ?? target.dataset.cellY;
          if (data.dragLastX !== cx || data.dragLastY !== cy) {
            data.dragLastX = cx; data.dragLastY = cy;
            if (el) { el.dataset.predX = cx; el.dataset.predY = cy; }
            hyperspace.call('move_brick', [parseInt(data.dragBrick), parseInt(cx), parseInt(cy)]);
          }
        };
        pointerup -> {
          if (!data.dragBrick) return;
          if (data.dragMoved === '1') hyperspace.call('end_drag', []);
          attr('data-drag-brick', false);
          attr('data-drag-start-x', false);
          attr('data-drag-start-y', false);
          attr('data-drag-moved', false);
          attr('data-drag-last-x', false);
          attr('data-drag-last-y', false);
        }">

  <div id="app" class="relative w-full h-full">
    {% include "_stage.html.j2" %}
    {% include "_cursors.html.j2" %}
  </div>

  {# Welcome modal lives outside #app so broadcasts (which morph #app) never wipe it. #}
  {% if show_player_setup %}
  <div id="setup-overlay" class="absolute inset-0 z-50 flex items-center justify-center bg-background/80 backdrop-blur-md font-sans text-sm text-foreground overflow-y-auto p-4">
    <div class="flex flex-col sm:flex-row items-stretch gap-4 my-auto">

      {# Form card #}
      <div class="w-full sm:w-[280px] rounded-2xl bg-card border border-border p-6 shadow-iso flex flex-col gap-5">
        <div class="space-y-2">
          <div class="text-xs uppercase tracking-widest font-medium text-muted-foreground">Name</div>
          <input name="set_name" autofocus
                 hx-on="keydown[event.key=='Enter'] -> q('button[name=continue]').click()"
                 class="w-full rounded-xl bg-card border border-border px-3 py-2 text-foreground outline-none focus:border-primary transition-colors font-sans text-base sm:text-sm">
        </div>

        <div class="space-y-2">
          <div class="text-xs uppercase tracking-widest font-medium text-muted-foreground">Color</div>
          <div class="flex gap-2 justify-between">
            {% for c in ['Cyan','Pink','Purple','Yellow','Green','Orange'] %}
            <button type="button" data-color="{{ c }}"
                    hx-on="click -> take('.is-selected', '.color-pick')"
                    class="color-pick relative h-7 w-7 rounded-md cursor-pointer transition-transform hover:scale-110 bg-brick-{{ c|lower }}">
              <span class="pick-check absolute inset-0 items-center justify-center">
                <span class="icon-[lucide--check] text-foreground size-5 [filter:drop-shadow(0_1px_2px_rgba(255,255,255,0.85))] dark:[filter:drop-shadow(0_1px_2px_rgba(0,0,0,0.85))]"></span>
              </span>
            </button>
            {% endfor %}
          </div>
        </div>

        <button name="continue"
                :disabled="!q('input[name=set_name]').value.trim() || q('.color-pick.is-selected').count === 0"
                hx-on="click -> {
                  var name = document.querySelector('input[name=set_name]').value.trim();
                  var sel = document.querySelector('.color-pick.is-selected');
                  hyperspace.call('complete_setup', [name, sel.dataset.color]);
                  document.getElementById('setup-overlay').remove();
                }"
                class="mt-auto w-full rounded-xl bg-primary text-primary-foreground font-semibold py-2 cursor-pointer transition-colors hover:bg-primary/90
                       disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-primary">
          Continue
        </button>
      </div>

      {# Controls card #}
      <div class="w-full sm:w-[260px] rounded-2xl bg-card border border-border p-6 shadow-iso flex flex-col gap-5">
        <div class="text-xs uppercase tracking-widest font-medium text-muted-foreground">Controls</div>
        <div class="flex-1 grid grid-cols-[auto_1fr] items-center gap-x-5 gap-y-4 py-2 text-sm">
          <div class="flex items-center justify-end gap-1.5">
            <kbd class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-muted border border-border font-mono text-[10px] font-semibold text-foreground shadow-iso-sm">
              <span class="icon-[lucide--mouse-pointer-click] size-3 text-muted-foreground"></span>CLICK
            </kbd>
          </div>
          <span class="text-foreground">Place</span>

          <div class="flex items-center justify-end gap-1.5">
            <kbd class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-muted border border-border font-mono text-[10px] font-semibold text-foreground shadow-iso-sm">
              <span class="icon-[lucide--mouse-pointer-click] size-3 text-muted-foreground"></span>CLICK
            </kbd>
            <span class="text-muted-foreground">+</span>
            <kbd class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-muted border border-border font-mono text-[10px] font-semibold text-foreground shadow-iso-sm">
              <span class="icon-[lucide--move] size-3 text-muted-foreground"></span>DRAG
            </kbd>
          </div>
          <span class="text-foreground">Move</span>

          <div class="flex items-center justify-end gap-1.5">
            <kbd class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-muted border border-border font-mono text-[10px] font-semibold text-foreground shadow-iso-sm">
              <span class="icon-[lucide--arrow-big-up] size-3 text-muted-foreground"></span>SHIFT
            </kbd>
            <span class="text-muted-foreground">+</span>
            <kbd class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-muted border border-border font-mono text-[10px] font-semibold text-foreground shadow-iso-sm">
              <span class="icon-[lucide--mouse-pointer-click] size-3 text-muted-foreground"></span>CLICK
            </kbd>
          </div>
          <span class="text-foreground">Erase</span>
        </div>
      </div>

    </div>
  </div>
  {% endif %}

</body>
</html>
