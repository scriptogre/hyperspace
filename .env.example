# Compose
# ------------------------------------------------------------------------------
# Local (default): docker-compose.local.yml
# Production:      docker-compose.production.yml
# Public host:     docker-compose.production.yml:docker-compose.caddy.yml
COMPOSE_FILE=docker-compose.local.yml


# Application
# ------------------------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true
# Number of uvicorn workers in production
WEB_CONCURRENCY=4
# Public domain Caddy serves (only used with the caddy compose layer)
SITE_DOMAIN=hyperspace.example.com


# Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Host is the compose service name; the app runs in the same network.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=hyperspace
POSTGRES_PASSWORD=hyperspace
POSTGRES_DB=hyperspace
